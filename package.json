{
  "name": "my-app",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fitness-app-dev --local",
    "db:migrate:remote": "wrangler d1 migrations apply fitness-app-dev --remote"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "wrangler": "^4.110.0"
  }
}
