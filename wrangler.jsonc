{
	// Cloudflare Workers の設定ファイル。アプリの名前や、使うDBなどを書く
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-app",
	"main": "src/index.ts",
	// Workersの動作バージョンの基準日（むやみに変えない）
	"compatibility_date": "2026-10-04",
	// データベースの設定
	"d1_databases": [
		{
			// コード内で使う名前。c.env.fitness_app_devでDBにアクセスする
			"binding": "fitness_app_dev",
			"database_name": "fitness-app-dev",
			"database_id": "c8d0c272-c060-4404-89de-65cd84681cdb",
			// マイグレーション SQL が入っているフォルダ（drizzle の出力先）
			"migrations_dir": "drizzle"
		}
	]
	// "compatibility_flags": [
	//   "nodejs_compat"
	// ],
	// "vars": {
	//   "MY_VAR": "my-variable"
	// },
	// "kv_namespaces": [
	//   {
	//     "binding": "MY_KV_NAMESPACE",
	//     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
	//   }
	// ],
	// "r2_buckets": [
	//   {
	//     "binding": "MY_BUCKET",
	//     "bucket_name": "my-bucket"
	//   }
	// ],
	// "d1_databases": [
	//   {
	//     "binding": "MY_DB",
	//     "database_name": "my-database",
	//     "database_id": ""
	//   }
	// ],
	// "ai": {
	//   "binding": "AI"
	// },
